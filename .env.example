# Example Environment Configuration
# Copy this to .env and fill in your actual values
# IMPORTANT: Never commit your .env file to GitHub!

# Your Gemini API Key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Use local provider (T5 model) or Gemini API
# Set to "false" to use Gemini API (recommended)
# Set to "true" to use local T5 model (free but lower quality)
USE_LOCAL_PROVIDER=false

# Gemini model to use
# Recommended: gemini-2.0-flash-lite (free tier)
# Other options: gemini-2.0-flash, gemini-1.5-pro, etc.
GEMINI_MODEL=gemini-2.0-flash-lite
