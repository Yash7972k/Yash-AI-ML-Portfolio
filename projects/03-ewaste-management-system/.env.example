# ==================== DATABASE ====================
DATABASE_URL=sqlite:///./ewaste.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/ewaste

# ==================== APP CONFIG ====================
APP_NAME=E-Waste Management System
DEBUG=True
LOG_LEVEL=INFO

# ==================== SECURITY ====================
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
SENDGRID_API_KEY=your-sendgrid-key

# ==================== SMS (Twilio) ====================
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ==================== PAYMENT (Razorpay) ====================
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ==================== GOOGLE MAPS ====================
GOOGLE_MAPS_API_KEY=your-google-maps-key

# ==================== LOCATION ====================
DEFAULT_CITY=Pune
DEFAULT_LATITUDE=18.5204
DEFAULT_LONGITUDE=73.8567

# ==================== COLLECTION POINTS ====================
MAX_COLLECTION_POINTS=50
MIN_CAPACITY=100
